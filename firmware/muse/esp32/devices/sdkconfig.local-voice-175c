# Apply after the common display and Waveshare 1.75C overlays.
CONFIG_MUSE_LOCAL_VOICE=y
CONFIG_GADGET_PRODUCT_NAME="Voice"
# CONFIG_GADGET_SDK_TOKEN_WARN is not set
# CONFIG_GADGET_SDK_TOKEN_CONSOLE is not set
# CONFIG_HOMEHUB_OTA_ENABLED is not set
# CONFIG_HOMEHUB_ERROR_REPORT is not set
# CONFIG_HOMEHUB_SUPPORT_BUG_REPORT is not set
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_MAX_BONDS=1
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=247
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000
CONFIG_OPUS_NONTHREADSAFE_PSEUDOSTACK=y
CONFIG_OPUS_PSEUDOSTACK_SIZE=120000
CONFIG_OPUS_PSEUDOSTACK_PREFER_PSRAM=y
CONFIG_OPUS_STATE_PREFER_PSRAM=y
# CONFIG_OPUS_FLOATING_POINT is not set
