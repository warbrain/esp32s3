CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# 20 ms Opus frames are small, but keep some WiFi TX headroom.
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=64

# micro-opus: one shared pseudostack (guarded by s_opus_lock). 120 kB of Opus
# scratch in internal RAM starves the LCD SPI DMA, and fixed-point Opus is happy
# with both the scratch and the codec state in PSRAM.
CONFIG_OPUS_NONTHREADSAFE_PSEUDOSTACK=y
CONFIG_OPUS_PSEUDOSTACK_SIZE=60000
CONFIG_OPUS_PSEUDOSTACK_PREFER_PSRAM=y
CONFIG_OPUS_STATE_PREFER_PSRAM=y
# CONFIG_OPUS_FLOATING_POINT is not set

# Status screen fonts (symbol glyphs come from the built-in Montserrat faces).
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_32=y

# The dashboard creates many widgets: LVGL's fixed 64 kB TLSF pool is too small
# and corrupts itself when it fills up, so use the C library allocator.
CONFIG_LV_USE_CLIB_MALLOC=y
# CONFIG_LV_USE_BUILTIN_MALLOC is not set
CONFIG_LV_FONT_MONTSERRAT_48=y
