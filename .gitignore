# Build output
build/
managed_components/
sdkconfig
sdkconfig.old
*.o
*.obj
*.a
*.lib
*.dll
*.exe
*.pdb
*.bin

# Models and assets. Anchored on purpose: 3rd_party/native/source also has
# directories called "models", and those are source code.
/models/
/hmi/models/
/voice/models/
*.gguf
*.onnx
*.safetensors
*.wav
# The pinned native SDK CMake configuration embeds these tracked demo assets.
!/voice/3rd_party/native/source/webui/native/demo_voices/*.wav

# Local runtime output
/hmi/logs/
/hmi/config/app.yaml
/voice/logs/
/voice/config/app.yaml

# Docs are not tracked in this repository, but upstream files are: several
# third-party CMakeLists require their README at configure time (CPack
# resources), e.g. 3rd_party/native/source/external/sentencepiece.
*.md
!voice/3rd_party/**/*.md
!/firmware/muse/**/*.md
/docs/

# IDE / OS
.vs/
.vscode/
__pycache__/
*.pyc
Thumbs.db
.DS_Store

# Local build helpers
dependencies.lock
idf-env.txt
