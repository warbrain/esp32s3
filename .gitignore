# Build output
build/
managed_components/
sdkconfig
sdkconfig.old
*.o
*.obj
*.a
*.lib
*.dll
*.exe
*.pdb
*.bin

# Models and assets. Anchored on purpose: 3rd_party/native/source also has
# directories called "models", and those are source code.
/models/
/hmi/models/
*.gguf
*.onnx
*.safetensors
*.wav

# Local runtime output
/hmi/logs/
/hmi/config/app.yaml

# Docs are not tracked in this repository, but upstream files are: several
# third-party CMakeLists require their README at configure time (CPack
# resources), e.g. 3rd_party/native/source/external/sentencepiece.
*.md
!hmi/3rd_party/**/*.md
/docs/

# IDE / OS
.vs/
.vscode/
__pycache__/
*.pyc
Thumbs.db
.DS_Store
