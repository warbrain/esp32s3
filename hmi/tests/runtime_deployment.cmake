cmake_minimum_required(VERSION 3.24)

foreach(_argument IN ITEMS PROJECT_ROOT TEST_ROOT)
  if(NOT DEFINED ${_argument} OR "${${_argument}}" STREQUAL "")
    message(FATAL_ERROR "Missing deployment test argument: ${_argument}")
  endif()
endforeach()
set(_helper "${PROJECT_ROOT}/cmake/DeployRuntime.cmake")
if(NOT EXISTS "${_helper}")
  message(FATAL_ERROR "Deployment helper is missing: ${_helper}")
endif()

# Keep every run in its own build-tree fixture; never modify an installed SDK.
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef _run)
set(_fixture "${TEST_ROOT}/${_run}")
set(_sdk "${_fixture}/sdk")
set(_source "${_sdk}/bin")
set(_destination "${_fixture}/runtime")
file(MAKE_DIRECTORY "${_source}" "${_sdk}/include" "${_destination}")

function(write_manifest)
  file(GLOB_RECURSE _inputs LIST_DIRECTORIES FALSE
    "${_sdk}/bin/*" "${_sdk}/include/*")
  list(SORT _inputs)
  set(_entries "")
  foreach(_input IN LISTS _inputs)
    file(RELATIVE_PATH _relative "${_sdk}" "${_input}")
    file(SHA256 "${_input}" _hash)
    if(NOT _entries STREQUAL "")
      string(APPEND _entries ",\n")
    endif()
    string(APPEND _entries "    {\"file\":\"${_relative}\",\"sha256\":\"${_hash}\"}")
  endforeach()
  file(WRITE "${_sdk}/sdk-manifest.json"
    "{\"schema\":1,\"abi\":512,\"build\":\"fixture\",\"files\":[\n${_entries}\n]}\n")
endfunction()

function(deploy expected label source destination)
  execute_process(COMMAND "${CMAKE_COMMAND}"
    "-DSOURCE_DIR=${source}" "-DDESTINATION_DIR=${destination}"
    -DREQUIRE_MANIFEST=ON -P "${_helper}"
    RESULT_VARIABLE _result OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr)
  file(WRITE "${_fixture}/${label}.log" "exit=${_result}\n${_stdout}\n${_stderr}")
  if(expected STREQUAL "pass")
    if(NOT "${_result}" STREQUAL "0")
      message(FATAL_ERROR "${label}: deployment failed: ${_stdout}\n${_stderr}")
    endif()
  elseif("${_result}" STREQUAL "0")
    message(FATAL_ERROR "${label}: invalid SDK/path unexpectedly accepted")
  endif()
  message(STATUS "PASS ${label}")
endfunction()

function(assert_contents path expected label)
  if(NOT EXISTS "${path}")
    message(FATAL_ERROR "${label}: expected file does not exist: ${path}")
  endif()
  file(READ "${path}" _actual)
  if(NOT _actual STREQUAL expected)
    message(FATAL_ERROR "${label}: content differs: ${path}")
  endif()
  message(STATUS "PASS ${label}")
endfunction()

file(WRITE "${_source}/native.dll" "sdk version 1")
file(WRITE "${_source}/ggml.dll" "ggml core")
file(WRITE "${_source}/ggml-cpu-x64.dll" "cpu plugin")
file(WRITE "${_source}/ggml-cuda.dll" "cuda plugin")
file(WRITE "${_sdk}/include/audiocpp.h" "matching SDK header")
file(WRITE "${_destination}/hmi_ggml_backend_ops.exe" "executable sentinel")
file(WRITE "${_destination}/keep.json" "user config sentinel")
write_manifest()
deploy(pass initial_sync "${_source}" "${_destination}")
assert_contents("${_destination}/native.dll" "sdk version 1" initial_version)

# Re-run only the deployment helper, without compiling or relinking an app.
file(WRITE "${_source}/native.dll" "sdk version 2")
write_manifest()
deploy(pass updated_sdk_without_relink "${_source}" "${_destination}")
assert_contents("${_destination}/native.dll" "sdk version 2" updated_runtime_version)

file(REMOVE "${_source}/ggml-cuda.dll")
write_manifest()
deploy(pass removed_plugin_sync "${_source}" "${_destination}")
if(EXISTS "${_destination}/ggml-cuda.dll")
  message(FATAL_ERROR "Removed CUDA plugin remains in the deployed runtime")
endif()
assert_contents("${_destination}/hmi_ggml_backend_ops.exe" "executable sentinel" executable_preserved)
assert_contents("${_destination}/keep.json" "user config sentinel" non_dll_file_preserved)

file(WRITE "${_source}/native.dll" "tampered DLL")
deploy(fail tampered_dll_rejected "${_source}" "${_destination}")
assert_contents("${_destination}/native.dll" "sdk version 2" rejected_dll_does_not_mutate_runtime)
file(WRITE "${_source}/native.dll" "sdk version 2")
file(WRITE "${_sdk}/include/audiocpp.h" "mismatched header")
deploy(fail tampered_header_rejected "${_source}" "${_destination}")
assert_contents("${_destination}/native.dll" "sdk version 2" rejected_header_does_not_mutate_runtime)
file(WRITE "${_sdk}/include/audiocpp.h" "matching SDK header")

file(WRITE "${_source}/ggml-untracked.dll" "untracked plugin")
deploy(fail extra_plugin_rejected "${_source}" "${_destination}")
if(EXISTS "${_destination}/ggml-untracked.dll")
  message(FATAL_ERROR "Untracked DLL was installed before validation completed")
endif()
file(REMOVE "${_source}/ggml-untracked.dll")
file(READ "${_sdk}/sdk-manifest.json" _manifest)
file(REMOVE "${_sdk}/sdk-manifest.json")
deploy(fail missing_manifest_rejected "${_source}" "${_destination}")
file(WRITE "${_sdk}/sdk-manifest.json" "${_manifest}")

deploy(fail identical_paths_rejected "${_source}" "${_source}")
deploy(fail destination_inside_source_rejected "${_source}" "${_source}/runtime")
deploy(fail destination_contains_source_rejected "${_source}" "${_sdk}")
if(WIN32)
  string(TOUPPER "${_source}" _source_alias)
  deploy(fail windows_case_alias_rejected "${_source}" "${_source_alias}")
endif()
if(EXISTS "${_source}/runtime")
  message(FATAL_ERROR "Invalid nested deployment created its destination")
endif()
assert_contents("${_source}/native.dll" "sdk version 2" source_survives_invalid_paths)
assert_contents("${_destination}/hmi_ggml_backend_ops.exe" "executable sentinel" executable_survives_all_rejections)
message(STATUS "Runtime deployment regression passed; fixture: ${_fixture}")
