cmake_minimum_required(VERSION 3.24)
if(NOT TEST_ROOT)
  message(FATAL_ERROR "Set TEST_ROOT to an isolated test directory")
endif()
string(RANDOM LENGTH 10 ALPHABET 0123456789abcdef _id)
set(_root "${TEST_ROOT}/${_id}")
get_filename_component(PROJECT_SOURCE_DIR "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
include("${PROJECT_SOURCE_DIR}/cmake/AudioSource.cmake")
set(_shader_binary "${_root}/shader-sdk")
set(_shader_cache "${_shader_binary}/ggml/upstream/src/ggml-vulkan/vulkan-shaders-gen-prefix/src/vulkan-shaders-gen-build/CMakeCache.txt")
get_filename_component(_shader_directory "${_shader_cache}" DIRECTORY)
file(MAKE_DIRECTORY "${_shader_directory}")
file(WRITE "${_shader_cache}" "CMAKE_HOME_DIRECTORY:INTERNAL=${PROJECT_SOURCE_DIR}/3rd_party/audiocpp/source/external/ggml/src/ggml-vulkan/vulkan-shaders\n")
hmi_migrate_native_shader_cache("${_shader_binary}")
if(EXISTS "${_shader_cache}")
  message(FATAL_ERROR "Legacy shader source cache was not invalidated")
endif()
file(WRITE "${_shader_cache}" "CMAKE_HOME_DIRECTORY:INTERNAL=${PROJECT_SOURCE_DIR}/3rd_party/native/source/external/ggml/src/ggml-vulkan/vulkan-shaders\n")
hmi_migrate_native_shader_cache("${_shader_binary}")
if(NOT EXISTS "${_shader_cache}")
  message(FATAL_ERROR "Current native shader cache was invalidated")
endif()
set(_raw "${_root}/raw")
set(_source "${_root}/source")
set(_package "${_root}/package")
file(MAKE_DIRECTORY "${_raw}" "${_source}/include" "${_source}/model_specs")
foreach(_name native ggml ggml-base ggml-cpu)
  file(WRITE "${_raw}/${_name}.dll" "${_name}-v1")
  file(WRITE "${_raw}/${_name}.lib" "import-${_name}")
endforeach()
file(WRITE "${_raw}/ggml-cuda.dll" "obsolete-output-must-not-be-staged")
file(WRITE "${_raw}/audiocpp.dll" "legacy-facade-must-not-be-staged")
file(WRITE "${_source}/include/audiocpp.h" "#define AUDIOCPP_ABI_VERSION_MAJOR 0\n#define AUDIOCPP_ABI_VERSION_MINOR 2\n#define AUDIOCPP_ABI_VERSION_PATCH 0\n")
file(WRITE "${_source}/model_specs/qwen3_asr.json" "{}")
file(WRITE "${_source}/model_specs/qwen3_tts.json" "{}")
file(WRITE "${_source}/LICENSE" "fixture license")
file(MAKE_DIRECTORY "${_source}/external/vendor")
file(WRITE "${_source}/external/vendor/LICENSE" "fixture vendor license")
file(SHA256 "${_source}/external/vendor/LICENSE" _vendor_license_hash)
file(WRITE "${_source}/license-manifest.json"
  "[{\"path\":\"external/vendor/LICENSE\",\"sha256\":\"${_vendor_license_hash}\"}]")
set(_inputs "${_root}/inputs.cmake")
set(_files)
foreach(_name native ggml ggml-base ggml-cpu)
  list(APPEND _files "${_raw}/${_name}.dll")
endforeach()
file(WRITE "${_inputs}" "set(SDK_RUNTIME_FILES [==[${_files}]==])\n")
function(stage expected)
  execute_process(COMMAND "${CMAKE_COMMAND}" "-DSDK_RAW_BIN=${_raw}" "-DSDK_PACKAGE_ROOT=${_package}"
    "-DSDK_SOURCE=${_source}" "-DSDK_INPUTS_FILE=${_inputs}"
    "-DAUDIOCPP_IMPORT=${_raw}/native.lib" "-DGGML_IMPORT=${_raw}/ggml.lib" "-DGGML_BASE_IMPORT=${_raw}/ggml-base.lib"
    -P "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../cmake/StageAudioSdk.cmake"
    RESULT_VARIABLE _result OUTPUT_VARIABLE _output ERROR_VARIABLE _errors)
  if(expected STREQUAL "success" AND NOT _result EQUAL 0)
    message(FATAL_ERROR "Source SDK staging unexpectedly failed: ${_output}${_errors}")
  elseif(expected STREQUAL "failure" AND _result EQUAL 0)
    message(FATAL_ERROR "Invalid source SDK staging unexpectedly succeeded")
  endif()
endfunction()
stage(success)
if(EXISTS "${_package}/bin/ggml-cuda.dll" OR EXISTS "${_package}/bin/audiocpp.dll")
  message(FATAL_ERROR "Stale raw output was staged despite not being a current SDK target")
endif()
foreach(_required bin/native.dll lib/native.lib licenses/native-LICENSE licenses/third_party/external/vendor/LICENSE)
  if(NOT EXISTS "${_package}/${_required}")
    message(FATAL_ERROR "Native facade output was not staged: ${_required}")
  endif()
endforeach()
file(READ "${_package}/licenses/third_party/external/vendor/LICENSE" _vendor_notice)
if(NOT _vendor_notice STREQUAL "fixture vendor license")
  message(FATAL_ERROR "Native dependency license was not preserved")
endif()
file(READ "${_package}/sdk-manifest.json" _manifest)
string(JSON _abi GET "${_manifest}" abi)
string(JSON _build GET "${_manifest}" build)
if(NOT _abi EQUAL 512 OR NOT _build STREQUAL "dev")
  message(FATAL_ERROR "Source ABI/build label was not derived correctly")
endif()
file(WRITE "${_package}/bin/ggml-removed.dll" "old plugin")
file(WRITE "${_package}/bin/audiocpp.dll" "old facade")
file(WRITE "${_package}/lib/audiocpp.lib" "old import library")
file(WRITE "${_package}/bin/diagnostic.exe" "preserve executable")
file(WRITE "${_raw}/ggml.dll" "ggml-v2")
stage(success)
file(READ "${_package}/bin/ggml.dll" _version)
if(NOT _version STREQUAL "ggml-v2" OR EXISTS "${_package}/bin/ggml-removed.dll" OR
    EXISTS "${_package}/bin/audiocpp.dll" OR EXISTS "${_package}/lib/audiocpp.lib" OR
    NOT EXISTS "${_package}/bin/diagnostic.exe")
  message(FATAL_ERROR "Source SDK refresh did not update exact DLL set safely")
endif()
file(SHA256 "${_package}/bin/ggml.dll" _before)
file(REMOVE "${_source}/include/audiocpp.h")
file(WRITE "${_raw}/ggml.dll" "must-not-replace-on-error")
stage(failure)
file(SHA256 "${_package}/bin/ggml.dll" _after)
if(NOT _before STREQUAL _after)
  message(FATAL_ERROR "Incomplete source SDK changed the previously staged runtime")
endif()
message(STATUS "Source SDK staging: exact target set, ABI label, refresh, cleanup and invalid-input preservation passed")

# An existing model specification must regenerate the embedded catalog when
# only its contents change. No audio/model implementation is compiled here.
get_filename_component(_cmake_bin "${CMAKE_COMMAND}" DIRECTORY)
find_program(_ninja NAMES ninja ninja.exe HINTS "${_cmake_bin}/../../Ninja")
if(_ninja)
  set(_watch_source "${_root}/watch-source")
  set(_watch_build "${_root}/watch-build")
  file(MAKE_DIRECTORY "${_watch_source}/vendor/model_specs")
  file(WRITE "${_watch_source}/vendor/model_specs/model.json" "catalog-before")
  file(WRITE "${_watch_source}/vendor/CMakeLists.txt"
    "file(GLOB _specs CONFIGURE_DEPENDS \"\${CMAKE_CURRENT_SOURCE_DIR}/model_specs/*.json\")\nfile(READ \"\${CMAKE_CURRENT_SOURCE_DIR}/model_specs/model.json\" _spec)\nfile(GENERATE OUTPUT \"\${CMAKE_CURRENT_BINARY_DIR}/catalog.txt\" CONTENT \"\${_spec}\")\n")
  get_filename_component(_project_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
  file(WRITE "${_watch_source}/CMakeLists.txt"
    "cmake_minimum_required(VERSION 3.24)\nproject(ModelSpecWatch NONE)\ninclude(\"${_project_root}/cmake/AudioSource.cmake\")\nadd_subdirectory(vendor)\nhmi_track_audio_model_specs(\"\${CMAKE_CURRENT_SOURCE_DIR}/vendor\")\n")
  execute_process(COMMAND "${CMAKE_COMMAND}" -S "${_watch_source}" -B "${_watch_build}" -G Ninja
    "-DCMAKE_MAKE_PROGRAM=${_ninja}" RESULT_VARIABLE _configured OUTPUT_VARIABLE _output ERROR_VARIABLE _errors)
  if(NOT _configured EQUAL 0)
    message(FATAL_ERROR "Model specification fixture configure failed: ${_output}${_errors}")
  endif()
  execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 1 COMMAND_ERROR_IS_FATAL ANY)
  file(WRITE "${_watch_source}/vendor/model_specs/model.json" "catalog-after")
  execute_process(COMMAND "${CMAKE_COMMAND}" --build "${_watch_build}"
    RESULT_VARIABLE _built OUTPUT_VARIABLE _output ERROR_VARIABLE _errors)
  if(NOT _built EQUAL 0)
    message(FATAL_ERROR "Model specification incremental rebuild failed: ${_output}${_errors}")
  endif()
  file(READ "${_watch_build}/vendor/catalog.txt" _catalog)
  if(NOT _catalog STREQUAL "catalog-after")
    message(FATAL_ERROR "An existing JSON edit did not regenerate the embedded model catalog")
  endif()
  message(STATUS "Source SDK model specification content edit regenerated its embedded catalog")
else()
  message(STATUS "Ninja unavailable; incremental model specification fixture skipped")
endif()
