cmake_minimum_required(VERSION 3.24)
include("${CMAKE_CURRENT_LIST_DIR}/../cmake/FindHmiCudnn.cmake")
if(NOT TEST_ROOT)
  message(FATAL_ERROR "Set TEST_ROOT to an isolated writable fixture directory")
endif()
string(RANDOM LENGTH 8 ALPHABET 0123456789abcdef _id)
set(_fixture "${TEST_ROOT}/${_id}")
file(MAKE_DIRECTORY "${_fixture}")
function(make_set root line)
  if(line STREQUAL "flat")
    set(inc "${root}/include")
    set(lib "${root}/lib/x64")
    set(bin "${root}/bin")
  else()
    set(inc "${root}/include/${line}")
    set(lib "${root}/lib/${line}/x64")
    set(bin "${root}/bin/${line}/x64")
  endif()
  file(MAKE_DIRECTORY "${inc}" "${lib}" "${bin}")
  file(WRITE "${inc}/cudnn.h" "// discovery fixture only\n")
  file(WRITE "${inc}/cudnn_version.h" "#define CUDNN_MAJOR 9\n#define CUDNN_MINOR 27\n#define CUDNN_PATCHLEVEL 0\n")
  file(WRITE "${lib}/cudnn.lib" "fixture-${line}")
  foreach(component "" _adv _cnn _graph _heuristic _ops _engines_precompiled _engines_runtime_compiled)
    file(WRITE "${bin}/cudnn${component}64_9.dll" "fixture-${line}")
  endforeach()
endfunction()
set(_checks 0)
macro(expect_found root cuda)
  hmi_find_cudnn(found ROOT "${root}" CUDA_VERSION "${cuda}" ${ARGN})
  if(NOT found_FOUND)
    message(FATAL_ERROR "Expected discovery success: ${found_ERROR}")
  endif()
  math(EXPR _checks "${_checks} + 1")
endmacro()
macro(expect_rejected root cuda)
  hmi_find_cudnn(found ROOT "${root}" CUDA_VERSION "${cuda}" ${ARGN})
  if(found_FOUND OR NOT found_ERROR)
    message(FATAL_ERROR "Invalid/mismatched cuDNN set was accepted: ${root} for ${cuda}")
  endif()
  math(EXPR _checks "${_checks} + 1")
endmacro()
set(multi "${_fixture}/installed-v9.27")
make_set("${multi}" 12.9)
make_set("${multi}" 13.4)
expect_found("${multi}" 13.4)
if(NOT found_LIBRARY STREQUAL "${multi}/lib/13.4/x64/cudnn.lib" OR
   NOT found_INCLUDE_DIR STREQUAL "${multi}/include/13.4" OR
   NOT found_RUNTIME_BIN STREQUAL "${multi}/bin/13.4/x64")
  message(FATAL_ERROR "Discovery mixed CUDA 12.9 and 13.4 files")
endif()
expect_found("${multi}" 12.9)
file(REMOVE "${multi}/lib/13.4/x64/cudnn.lib")
expect_rejected("${multi}" 13.4)
set(only12 "${_fixture}/only12")
make_set("${only12}" 12.9)
expect_rejected("${only12}" 13.4)
set(flat13 "${_fixture}/cudnn-windows-x86_64-9.27.0_cuda13-archive")
make_set("${flat13}" flat)
expect_found("${flat13}" 13.4)
set(flat12 "${_fixture}/cudnn-windows_cuda12-archive")
make_set("${flat12}" flat)
expect_rejected("${flat12}" 13.4)
set(neutral "${_fixture}/flat")
make_set("${neutral}" flat)
expect_rejected("${neutral}" 13.4)
expect_found("${neutral}" 13.4 ARCHIVE_CUDA_VERSION 13.4)
expect_rejected("${neutral}" 13.4 ARCHIVE_CUDA_VERSION 12.9)
expect_rejected("${neutral}" 13.4 ARCHIVE_CUDA_VERSION 13.0)
file(REMOVE "${neutral}/bin/cudnn_graph64_9.dll")
expect_rejected("${neutral}" 13.4 ARCHIVE_CUDA_VERSION 13.4)
make_set("${neutral}" flat)
file(REMOVE "${neutral}/bin/cudnn64_9.dll")
expect_rejected("${neutral}" 13.4 ARCHIVE_CUDA_VERSION 13.4)
make_set("${neutral}" flat)
file(WRITE "${neutral}/include/cudnn_version.h" "#define CUDNN_MAJOR 8\n#define CUDNN_MINOR 9\n#define CUDNN_PATCHLEVEL 0\n")
expect_rejected("${neutral}" 13.4 ARCHIVE_CUDA_VERSION 13.4)
expect_rejected("${multi}" "invalid")
set(_configuration_check "${_fixture}/reject-cudnn-without-cuda.cmake")
file(WRITE "${_configuration_check}" "set(WIN32 TRUE)\nset(CMAKE_SIZEOF_VOID_P 8)\nset(HMI_ENABLE_AUDIOCPP_SDK_BUILD ON CACHE BOOL \"\")\nset(HMI_AUDIOCPP_SDK_CUDNN ON CACHE BOOL \"\")\nset(HMI_AUDIOCPP_SDK_CUDA OFF CACHE BOOL \"\")\ninclude(\"${CMAKE_CURRENT_LIST_DIR}/../cmake/AudioSdkTuning.cmake\")\n")
execute_process(COMMAND "${CMAKE_COMMAND}" -P "${_configuration_check}"
  RESULT_VARIABLE _exit OUTPUT_VARIABLE _output ERROR_VARIABLE _errors)
if(_exit EQUAL 0 OR NOT "${_output}${_errors}" MATCHES "HMI_AUDIOCPP_SDK_CUDNN requires HMI_AUDIOCPP_SDK_CUDA=ON")
  message(FATAL_ERROR "SDK configuration did not reject cuDNN without CUDA: ${_output}${_errors}")
endif()
math(EXPR _checks "${_checks} + 1")
file(MAKE_DIRECTORY "${_fixture}/modules")
file(WRITE "${_fixture}/modules/FindCUDAToolkit.cmake" "set(CUDAToolkit_FOUND TRUE)\nset(CUDAToolkit_VERSION 13.4.92)\n")
file(WRITE "${_configuration_check}" "set(WIN32 TRUE)\nset(CMAKE_SIZEOF_VOID_P 8)\nset(HMI_ENABLE_AUDIOCPP_SDK_BUILD ON CACHE BOOL \"\")\nset(HMI_AUDIOCPP_SDK_CUDNN ON CACHE BOOL \"\")\nset(HMI_AUDIOCPP_SDK_CUDA ON CACHE BOOL \"\")\nset(HMI_CUDNN_CUDA_VERSION 12.9 CACHE STRING \"\")\nset(CMAKE_MODULE_PATH \"${_fixture}/modules\")\ninclude(\"${CMAKE_CURRENT_LIST_DIR}/../cmake/AudioSdkTuning.cmake\")\n")
execute_process(COMMAND "${CMAKE_COMMAND}" -P "${_configuration_check}"
  RESULT_VARIABLE _exit OUTPUT_VARIABLE _output ERROR_VARIABLE _errors)
if(_exit EQUAL 0 OR NOT "${_output}${_errors}" MATCHES "cuDNN CUDA version 12.9 does not match selected toolkit 13.4")
  message(FATAL_ERROR "SDK configuration accepted mismatched toolkit/cuDNN: ${_output}${_errors}")
endif()
math(EXPR _checks "${_checks} + 1")
message(STATUS "cuDNN discovery: ${_checks} layout/version/completeness checks passed")
