cmake_minimum_required(VERSION 3.24)
if(NOT TEST_ROOT OR NOT EXISTS "${CCACHE_EXECUTABLE}")
  message(FATAL_ERROR "Set TEST_ROOT and CCACHE_EXECUTABLE for the isolated real compiler cache check")
endif()
find_program(_ninja NAMES ninja ninja.exe HINTS "D:/Program Files/Microsoft Visual Studio/18/Enterprise/Common7/IDE/CommonExtensions/Microsoft/CMake/Ninja" REQUIRED)
string(RANDOM LENGTH 8 ALPHABET 0123456789abcdef _id)
set(_root "${TEST_ROOT}/${_id}")
file(MAKE_DIRECTORY "${_root}/source")
file(TO_CMAKE_PATH "${CMAKE_CURRENT_LIST_DIR}/../cmake/CompilerCache.cmake" _module)
file(WRITE "${_root}/source/CMakeLists.txt" "cmake_minimum_required(VERSION 3.24)\ninclude(\"${_module}\" NO_POLICY_SCOPE)\nproject(CacheFixture LANGUAGES C CXX)\nadd_library(cached_c OBJECT fixture.c)\nadd_library(cached_cpp OBJECT fixture.cpp)\nif(HMI_CACHE_FIXTURE_CUDA)\n  enable_language(CUDA)\n  add_library(cached_cuda OBJECT fixture.cu)\nendif()\nfile(WRITE \"\${CMAKE_BINARY_DIR}/launchers.txt\" \"C=\${CMAKE_C_COMPILER_LAUNCHER}\\nCXX=\${CMAKE_CXX_COMPILER_LAUNCHER}\\nCUDA=\${CMAKE_CUDA_COMPILER_LAUNCHER}\\nDEBUG=\${CMAKE_MSVC_DEBUG_INFORMATION_FORMAT}\\n\")\nhmi_write_ccache_initial_cache(\"\${CMAKE_BINARY_DIR}/child-cache.cmake\")\n")
file(WRITE "${_root}/source/fixture.c" "int cached_c_value(void) { return 123; }\n")
file(WRITE "${_root}/source/fixture.cpp" "#include <array>\nint cached_cpp_value() { const std::array<int, 3> x{1, 2, 3}; return x[0] + x[1] + x[2]; }\n")
file(WRITE "${_root}/source/fixture.cu" "__global__ void cached_cuda_value(float *out) { out[threadIdx.x] = 1.0f; }\n")
set(_cuda_flags "-DHMI_CACHE_FIXTURE_CUDA=OFF")
set(_fixture_executable "${CCACHE_EXECUTABLE}")
if(CMAKE_HOST_WIN32)
  # Exercise the native spelling supplied by PowerShell/CTest, which CMake
  # normalizes differently when it later loads a FILEPATH from an initial cache.
  file(TO_NATIVE_PATH "${CCACHE_EXECUTABLE}" _fixture_executable)
endif()
set(_expected_hits 2)
if(TEST_CUDA)
  if(NOT TEST_CUDA_ARCHITECTURES)
    set(TEST_CUDA_ARCHITECTURES native)
  endif()
  set(_cuda_flags "-DHMI_CACHE_FIXTURE_CUDA=ON" "-DCMAKE_CUDA_ARCHITECTURES=${TEST_CUDA_ARCHITECTURES}")
  set(_expected_hits 3)
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${_root}/source" -B "${_root}/build" -G Ninja
  "-DCMAKE_MAKE_PROGRAM=${_ninja}" "-DCMAKE_BUILD_TYPE=Debug" "-DHMI_USE_CCACHE=ON"
  "-DHMI_CCACHE_EXECUTABLE=${_fixture_executable}" "-DHMI_CCACHE_DIR=${_root}/cache"
  ${_cuda_flags}
  RESULT_VARIABLE _exit OUTPUT_VARIABLE _output ERROR_VARIABLE _errors)
file(WRITE "${_root}/configure.log" "${_output}${_errors}")
if(NOT _exit EQUAL 0)
  message(FATAL_ERROR "Compiler-cache fixture configure failed: ${_output}${_errors}")
endif()
file(READ "${_root}/build/launchers.txt" _launchers)
foreach(_language C CXX CUDA)
  if(NOT _launchers MATCHES "${_language}=[^\n]*CCACHE_DIR=${_root}/cache[^\n]*CCACHE_CONFIGPATH=[^\n]*ccache")
    message(FATAL_ERROR "${_language} launcher lost its executable or build-local cache environment: ${_launchers}")
  endif()
endforeach()
set(_cache_env "CCACHE_DIR=${_root}/cache" "CCACHE_CONFIGPATH=${_root}/cache/ccache.conf")
foreach(_run RANGE 1 2)
  execute_process(COMMAND "${CMAKE_COMMAND}" --build "${_root}/build" --clean-first --verbose
    RESULT_VARIABLE _exit OUTPUT_VARIABLE _output ERROR_VARIABLE _errors)
  file(WRITE "${_root}/build-${_run}.log" "${_output}${_errors}")
  if(NOT _exit EQUAL 0)
    message(FATAL_ERROR "ccache compiler invocation failed: ${_output}${_errors}")
  endif()
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env ${_cache_env} "${CCACHE_EXECUTABLE}" --print-stats --format json
    RESULT_VARIABLE _exit OUTPUT_VARIABLE _stats ERROR_VARIABLE _errors)
  file(WRITE "${_root}/stats-${_run}.json" "${_stats}")
  if(NOT _exit EQUAL 0)
    message(FATAL_ERROR "Cannot read isolated ccache statistics: ${_errors}")
  endif()
  string(JSON _direct GET "${_stats}" direct_cache_hit)
  string(JSON _preprocessed GET "${_stats}" preprocessed_cache_hit)
  math(EXPR _hits_${_run} "${_direct} + ${_preprocessed}")
endforeach()
math(EXPR _new_hits "${_hits_2} - ${_hits_1}")
execute_process(COMMAND "${CMAKE_COMMAND}" -E env ${_cache_env} "${CCACHE_EXECUTABLE}" --show-stats
  OUTPUT_VARIABLE _summary RESULT_VARIABLE _exit)
file(WRITE "${_root}/show-stats.txt" "${_summary}")
if(_new_hits LESS _expected_hits)
  message(FATAL_ERROR "Rebuilding the compiler fixtures did not produce ${_expected_hits} cache hits: ${_summary}; evidence ${_root}")
endif()
# A generated SDK initial cache must survive a second CMake process, including
# paths with spaces and the complete semicolon-delimited launcher command.
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${_root}/source" -B "${_root}/child" -G Ninja
  "-DCMAKE_MAKE_PROGRAM=${_ninja}" -C "${_root}/build/child-cache.cmake" "-DCMAKE_BUILD_TYPE=Debug"
  RESULT_VARIABLE _exit OUTPUT_VARIABLE _output ERROR_VARIABLE _errors)
file(WRITE "${_root}/child-configure.log" "${_output}${_errors}")
if(NOT _exit EQUAL 0)
  message(FATAL_ERROR "Generated SDK compiler-cache initial cache failed: ${_output}${_errors}")
endif()
file(READ "${_root}/child/launchers.txt" _child_launchers)
if(NOT _child_launchers STREQUAL _launchers)
  message(FATAL_ERROR "Generated initial cache changed the nested compiler launchers")
endif()
message(STATUS "Real ccache Debug rebuild: ${_new_hits} cache hits (CUDA fixture=${TEST_CUDA}); C/C++/CUDA launcher inheritance verified; evidence ${_root}")
