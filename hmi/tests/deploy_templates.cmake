cmake_minimum_required(VERSION 3.24)

if(NOT TEST_ROOT)
  message(FATAL_ERROR "Set TEST_ROOT to an isolated writable build directory")
endif()
set(_helper "${CMAKE_CURRENT_LIST_DIR}/../cmake/DeployTemplates.cmake")
if(NOT EXISTS "${_helper}")
  message(FATAL_ERROR "Configuration template deployment helper is missing")
endif()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef _id)
set(_fixture "${TEST_ROOT}/template-${_id}/中文 路径")
set(_source "${_fixture}/source")
set(_destination "${_fixture}/installed")
file(MAKE_DIRECTORY "${_source}/config/语音 子目录" "${_source}/rules/用户 场景")

function(deploy source destination label expected)
  execute_process(COMMAND "${CMAKE_COMMAND}"
    "-DSOURCE_DIR=${source}" "-DDESTINATION_DIR=${destination}" -P "${_helper}"
    RESULT_VARIABLE _code OUTPUT_VARIABLE _output ERROR_VARIABLE _errors)
  file(WRITE "${_fixture}/${label}.log" "exit=${_code}\n${_output}${_errors}")
  if(expected STREQUAL "pass" AND NOT "${_code}" STREQUAL "0")
    message(FATAL_ERROR "${label}: deployment failed: ${_output}${_errors}")
  elseif(expected STREQUAL "fail" AND "${_code}" STREQUAL "0")
    message(FATAL_ERROR "${label}: invalid deployment unexpectedly succeeded")
  endif()
  message(STATUS "PASS ${label}")
endfunction()

function(assert_contents file expected label)
  if(NOT EXISTS "${file}")
    message(FATAL_ERROR "${label}: required file missing: ${file}")
  endif()
  file(READ "${file}" _actual)
  if(NOT "${_actual}" STREQUAL "${expected}")
    message(FATAL_ERROR "${label}: content differs: ${file}")
  endif()
  message(STATUS "PASS ${label}")
endfunction()

set(_yaml "schema: 1\nvoice:\n  backend: auto\n")
set(_legacy "{\"toggle\":\"Ctrl+Shift+M\",\"hold\":\"Ctrl+Space\"}\n")
set(_engine "{\"families\":\"qwen3_asr,qwen3_tts\"}\n")
set(_nested "name: 初始配置\n")
set(_rules "{\"schema\":1,\"rules\":[{\"name\":\"默认规则\"}]}\n")
file(WRITE "${_source}/config/app.yaml" "${_yaml}")
file(WRITE "${_source}/config/hotkeys.json" "${_legacy}")
file(WRITE "${_source}/config/engine.json" "${_engine}")
file(WRITE "${_source}/config/语音 子目录/设置.yaml" "${_nested}")
file(WRITE "${_source}/rules/voice.json" "${_rules}")
file(WRITE "${_source}/rules/用户 场景/触发.json" "${_rules}")
deploy("${_source}/config" "${_destination}/config" first_configuration pass)
deploy("${_source}/rules" "${_destination}/rules" first_rules pass)
assert_contents("${_destination}/config/app.yaml" "${_yaml}" missing_yaml_copied)
assert_contents("${_destination}/config/hotkeys.json" "${_legacy}" missing_legacy_shortcuts_copied)
assert_contents("${_destination}/config/engine.json" "${_engine}" missing_engine_configuration_copied)
assert_contents("${_destination}/config/语音 子目录/设置.yaml" "${_nested}" missing_unicode_nested_configuration_copied)
assert_contents("${_destination}/rules/voice.json" "${_rules}" missing_rules_copied)
assert_contents("${_destination}/rules/用户 场景/触发.json" "${_rules}" missing_unicode_nested_rules_copied)

# Change both shipped defaults and user files, then simulate a later build.
# The user's bytes must win, including files unknown to the template source.
set(_user_yaml "schema: 1\nvoice:\n  backend: cpu\nlogging:\n  file: 日志/用户.log\n")
set(_user_legacy "{\"toggle\":\"Ctrl+F10\",\"hold\":\"Alt+Space\"}\n")
set(_user_engine "{\"families\":\"qwen3_asr\",\"custom\":true}\n")
set(_user_rules "{\"schema\":1,\"rules\":[{\"name\":\"用户规则\"}]}\n")
set(_user_nested "name: 用户修改\n")
file(WRITE "${_destination}/config/app.yaml" "${_user_yaml}")
file(WRITE "${_destination}/config/hotkeys.json" "${_user_legacy}")
file(WRITE "${_destination}/config/engine.json" "${_user_engine}")
file(WRITE "${_destination}/config/语音 子目录/设置.yaml" "${_user_nested}")
file(WRITE "${_destination}/rules/voice.json" "${_user_rules}")
file(WRITE "${_destination}/rules/用户 场景/触发.json" "${_user_rules}")
file(WRITE "${_destination}/rules/用户自建.json" "${_user_rules}")
file(WRITE "${_destination}/config/private.yaml" "preserve: 用户文件\n")
foreach(_file IN ITEMS app.yaml hotkeys.json engine.json "语音 子目录/设置.yaml")
  file(WRITE "${_source}/config/${_file}" "changed shipped default\n")
endforeach()
file(WRITE "${_source}/rules/voice.json" "changed shipped rules\n")
file(WRITE "${_source}/rules/用户 场景/触发.json" "changed shipped rules\n")
file(WRITE "${_source}/config/新增 默认.yaml" "new: 新默认\n")
file(WRITE "${_source}/rules/新增 默认.json" "{\"new\":true}\n")
deploy("${_source}/config" "${_destination}/config" updated_configuration pass)
deploy("${_source}/rules" "${_destination}/rules" updated_rules pass)
assert_contents("${_destination}/config/app.yaml" "${_user_yaml}" edited_yaml_preserved)
assert_contents("${_destination}/config/hotkeys.json" "${_user_legacy}" edited_legacy_shortcuts_preserved)
assert_contents("${_destination}/config/engine.json" "${_user_engine}" edited_engine_configuration_preserved)
assert_contents("${_destination}/config/语音 子目录/设置.yaml" "${_user_nested}" edited_unicode_nested_configuration_preserved)
assert_contents("${_destination}/rules/voice.json" "${_user_rules}" edited_rules_preserved)
assert_contents("${_destination}/rules/用户 场景/触发.json" "${_user_rules}" edited_unicode_nested_rules_preserved)
assert_contents("${_destination}/rules/用户自建.json" "${_user_rules}" user_only_rules_preserved)
assert_contents("${_destination}/config/private.yaml" "preserve: 用户文件\n" user_only_configuration_preserved)
assert_contents("${_destination}/config/新增 默认.yaml" "new: 新默认\n" new_configuration_added)
assert_contents("${_destination}/rules/新增 默认.json" "{\"new\":true}\n" new_rules_added)

# A removal from the source must not delete a deployed user configuration.
file(REMOVE "${_source}/config/app.yaml" "${_source}/rules/voice.json")
deploy("${_source}/config" "${_destination}/config" removed_configuration_source pass)
deploy("${_source}/rules" "${_destination}/rules" removed_rules_source pass)
assert_contents("${_destination}/config/app.yaml" "${_user_yaml}" removed_template_does_not_delete_user_yaml)
assert_contents("${_destination}/rules/voice.json" "${_user_rules}" removed_template_does_not_delete_user_rules)
deploy("${_source}/missing" "${_destination}/config" missing_source_rejected fail)
deploy("${_source}/config" "" missing_destination_rejected fail)
assert_contents("${_destination}/config/app.yaml" "${_user_yaml}" rejected_deployment_keeps_user_data)
message(STATUS "Configuration template deployment preservation passed; evidence ${_fixture}")
