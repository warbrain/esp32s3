cmake_minimum_required(VERSION 3.24)
if(NOT EXISTS "${PROBE_EXECUTABLE}")
  message(FATAL_ERROR "Probe executable not built")
endif()
function(expect_result expected)
  execute_process(COMMAND "${PROBE_EXECUTABLE}" ${ARGN}
    OUTPUT_VARIABLE output ERROR_VARIABLE errors RESULT_VARIABLE result TIMEOUT 30)
  string(JSON status ERROR_VARIABLE json_error GET "${output}" status)
  if(NOT json_error STREQUAL "NOTFOUND")
    message(FATAL_ERROR "Probe did not return valid JSON: ${output}; ${errors}")
  endif()
  if(expected STREQUAL "measured")
    string(JSON correct GET "${output}" correct)
    string(JSON time GET "${output}" median_us)
    if(NOT result EQUAL 0 OR NOT status STREQUAL "measured" OR NOT correct OR NOT time GREATER 0)
      message(FATAL_ERROR "Probe did not produce validated timing: ${output}; ${errors}")
    endif()
  elseif(result EQUAL 0 OR NOT status STREQUAL "failed")
    message(FATAL_ERROR "Invalid/missing device or option was accepted: ${output}")
  endif()
endfunction()
expect_result(failed invalid_mode)
expect_result(failed perf --runs 0)
expect_result(failed perf --size 100000)
expect_result(failed perf --threads 0)
expect_result(failed perf --op unsupported)
expect_result(failed perf --variant ../ggml-cpu-haswell.dll)
expect_result(failed perf --backend __hmi_missing_device__)
expect_result(failed perf --variant ggml-cpu-missing.dll)
expect_result(measured perf --backend CPU --threads 1 --size 32 --runs 1 --op matmul)
expect_result(measured perf --backend CPU --threads 2 --size 32 --runs 1 --op softmax)
message(STATUS "ggml probe: 8 rejected invalid requests and 2 numerically verified CPU timings")
