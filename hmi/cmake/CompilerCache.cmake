include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/ProjectPaths.cmake")

# Include before project(...), with NO_POLICY_SCOPE, so MSVC debug information
# can use /Z7 through CMP0141. All cache configuration remains in this build.
if(NOT DEFINED HMI_CCACHE_EXECUTABLE)
  if(EXISTS "D:/PKG/ccache/ccache.exe")
    set(HMI_CCACHE_EXECUTABLE "D:/PKG/ccache/ccache.exe" CACHE FILEPATH "ccache executable")
  else()
    find_program(HMI_CCACHE_EXECUTABLE NAMES ccache.exe ccache HINTS "D:/PKG/ccache" DOC "ccache executable")
  endif()
endif()
set(_hmi_ccache_available OFF)
if(HMI_CCACHE_EXECUTABLE AND EXISTS "${HMI_CCACHE_EXECUTABLE}")
  # A command-line FILEPATH may retain Windows backslashes, while loading a
  # generated initial cache normalizes them. Use one spelling in both launchers.
  get_filename_component(_hmi_ccache_executable "${HMI_CCACHE_EXECUTABLE}" ABSOLUTE BASE_DIR "${CMAKE_BINARY_DIR}")
  file(TO_CMAKE_PATH "${_hmi_ccache_executable}" _hmi_ccache_executable)
  set(HMI_CCACHE_EXECUTABLE "${_hmi_ccache_executable}" CACHE FILEPATH "ccache executable" FORCE)
  set(_hmi_ccache_available ON)
endif()
option(HMI_USE_CCACHE "Cache C/C++/CUDA compilation using the build-local ccache directory" ${_hmi_ccache_available})
set(HMI_CCACHE_DIR "${CMAKE_BINARY_DIR}/.ccache" CACHE PATH "Build-local ccache storage and configuration")
get_filename_component(_hmi_ccache_directory "${HMI_CCACHE_DIR}" ABSOLUTE BASE_DIR "${CMAKE_BINARY_DIR}")
file(TO_CMAKE_PATH "${_hmi_ccache_directory}" _hmi_ccache_directory)
set(HMI_CCACHE_DIR "${_hmi_ccache_directory}" CACHE PATH "Build-local ccache storage and configuration" FORCE)
# Fixtures may have sibling source/build/cache directories, all beneath the
# build directory of the project owning this module.
get_filename_component(_hmi_cache_project_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
hmi_require_build_path("${HMI_CCACHE_DIR}" "Compiler cache" "${_hmi_cache_project_root}")
if(HMI_USE_CCACHE)
  if(NOT _hmi_ccache_available)
    message(FATAL_ERROR "HMI_USE_CCACHE=ON requires a valid HMI_CCACHE_EXECUTABLE; expected D:/PKG/ccache/ccache.exe")
  endif()
  if(HMI_CCACHE_DIR MATCHES ";" OR HMI_CCACHE_EXECUTABLE MATCHES ";")
    message(FATAL_ERROR "ccache executable/cache paths must not contain CMake list separators")
  endif()
  file(MAKE_DIRECTORY "${HMI_CCACHE_DIR}")
  set(_hmi_ccache_config "${HMI_CCACHE_DIR}/ccache.conf")
  if(NOT EXISTS "${_hmi_ccache_config}")
    file(WRITE "${_hmi_ccache_config}" "# Build-local ccache configuration. No global configuration is changed.\n")
  endif()
  set(_hmi_ccache_launcher "${CMAKE_COMMAND};-E;env;CCACHE_DIR=${HMI_CCACHE_DIR};CCACHE_CONFIGPATH=${_hmi_ccache_config};${HMI_CCACHE_EXECUTABLE}")
  foreach(_language C CXX CUDA)
    set(CMAKE_${_language}_COMPILER_LAUNCHER "${_hmi_ccache_launcher}" CACHE STRING "Build-local ccache compiler launcher" FORCE)
  endforeach()
  # MSVC's shared /Zi PDB output cannot be cached safely. Preserve an explicit
  # user format; only choose embedded debug information when none was supplied.
  if(WIN32 AND POLICY CMP0141)
    cmake_policy(SET CMP0141 NEW)
    set(CMAKE_POLICY_DEFAULT_CMP0141 NEW)
    if(NOT DEFINED CMAKE_MSVC_DEBUG_INFORMATION_FORMAT)
      set(CMAKE_MSVC_DEBUG_INFORMATION_FORMAT "$<$<CONFIG:Debug,RelWithDebInfo>:Embedded>" CACHE STRING "Embedded debug information for cacheable MSVC compilations")
    endif()
  endif()
  if(NOT CMAKE_GENERATOR)
    message(STATUS "ccache initial-cache launchers ready; build-local storage ${HMI_CCACHE_DIR}")
  elseif(CMAKE_GENERATOR MATCHES "Ninja|Makefiles")
    message(STATUS "ccache compiler launchers enabled: ${HMI_CCACHE_EXECUTABLE}; build-local storage ${HMI_CCACHE_DIR}")
  else()
    message(STATUS "ccache is configured; ${CMAKE_GENERATOR} does not execute compiler launchers. Use Ninja to cache compilation.")
  endif()
else()
  foreach(_language C CXX CUDA)
    if(CMAKE_${_language}_COMPILER_LAUNCHER MATCHES "CCACHE_DIR=")
      unset(CMAKE_${_language}_COMPILER_LAUNCHER CACHE)
      unset(CMAKE_${_language}_COMPILER_LAUNCHER)
    endif()
  endforeach()
endif()

# Bracket quoting preserves launcher lists, spaces and generator expressions
# through nested CMake configurations, without shell/list escaping tricks.
function(hmi_write_ccache_initial_cache output)
  get_filename_component(_owner_project "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/.." ABSOLUTE)
  hmi_require_build_path("${output}" "Compiler cache configuration" "${_owner_project}")
  set(_content "# Generated build-local compiler cache settings.\n")
  foreach(_variable HMI_USE_CCACHE HMI_CCACHE_EXECUTABLE HMI_CCACHE_DIR CMAKE_MSVC_DEBUG_INFORMATION_FORMAT)
    if(DEFINED ${_variable})
      set(_type STRING)
      if(_variable STREQUAL "HMI_USE_CCACHE")
        set(_type BOOL)
      elseif(_variable STREQUAL "HMI_CCACHE_EXECUTABLE")
        set(_type FILEPATH)
      elseif(_variable STREQUAL "HMI_CCACHE_DIR")
        set(_type PATH)
      endif()
      set(_equals "==")
      while("${${_variable}}" MATCHES "\\]${_equals}\\]")
        string(APPEND _equals "=")
      endwhile()
      string(APPEND _content "set(${_variable} [${_equals}[${${_variable}}]${_equals}] CACHE ${_type} \"Inherited host compiler cache setting\" FORCE)\n")
    endif()
  endforeach()
  string(APPEND _content "include([==[${CMAKE_CURRENT_FUNCTION_LIST_DIR}/CompilerCache.cmake]==] NO_POLICY_SCOPE)\n")
  file(WRITE "${output}" "${_content}")
endfunction()
