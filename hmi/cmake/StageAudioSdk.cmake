cmake_minimum_required(VERSION 3.24)
foreach(_required SDK_RAW_BIN SDK_PACKAGE_ROOT SDK_SOURCE SDK_INPUTS_FILE AUDIOCPP_IMPORT GGML_IMPORT GGML_BASE_IMPORT)
  if(NOT DEFINED ${_required} OR "${${_required}}" STREQUAL "")
    message(FATAL_ERROR "Missing source SDK staging argument: ${_required}")
  endif()
endforeach()
include("${CMAKE_CURRENT_LIST_DIR}/ProjectPaths.cmake")
get_filename_component(_owner_project "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
cmake_path(ABSOLUTE_PATH SDK_RAW_BIN NORMALIZE OUTPUT_VARIABLE _raw)
cmake_path(ABSOLUTE_PATH SDK_PACKAGE_ROOT OUTPUT_VARIABLE _package)
hmi_require_build_path("${_package}" "SDK package output" "${_owner_project}")
string(TOLOWER "${_raw}" _raw_compare)
string(TOLOWER "${_package}" _package_compare)
cmake_path(IS_PREFIX _raw_compare "${_package_compare}" NORMALIZE _inside)
cmake_path(IS_PREFIX _package_compare "${_raw_compare}" NORMALIZE _contains)
if(_inside OR _contains)
  message(FATAL_ERROR "Source SDK outputs and staged package must be separate directories")
endif()
include("${SDK_INPUTS_FILE}")
set(_runtime "${SDK_RUNTIME_FILES}")
if(NOT _runtime)
  message(FATAL_ERROR "No source SDK target outputs were provided")
endif()
foreach(_file IN LISTS _runtime)
  if(NOT EXISTS "${_file}")
    message(FATAL_ERROR "Source SDK target output missing: ${_file}")
  endif()
endforeach()
foreach(_file "${AUDIOCPP_IMPORT}" "${GGML_IMPORT}" "${GGML_BASE_IMPORT}"
    "${SDK_SOURCE}/include/audiocpp.h" "${SDK_SOURCE}/model_specs/qwen3_asr.json"
    "${SDK_SOURCE}/model_specs/qwen3_tts.json" "${SDK_SOURCE}/LICENSE")
  if(NOT EXISTS "${_file}" OR IS_DIRECTORY "${_file}")
    message(FATAL_ERROR "Source SDK staging dependency missing: ${_file}")
  endif()
endforeach()
file(STRINGS "${SDK_SOURCE}/include/audiocpp.h" _abi_lines REGEX "^#define AUDIOCPP_ABI_VERSION_(MAJOR|MINOR|PATCH) [0-9]+")
foreach(_part MAJOR MINOR PATCH)
  set(_abi_${_part} "")
  foreach(_line IN LISTS _abi_lines)
    if(_line MATCHES "^#define AUDIOCPP_ABI_VERSION_${_part} ([0-9]+)")
      set(_abi_${_part} "${CMAKE_MATCH_1}")
    endif()
  endforeach()
  if(_abi_${_part} STREQUAL "")
    message(FATAL_ERROR "Cannot read the source SDK public ABI version")
  endif()
endforeach()
math(EXPR _abi "(${_abi_MAJOR} << 16) | (${_abi_MINOR} << 8) | ${_abi_PATCH}")
set(_license_files)
if(EXISTS "${SDK_SOURCE}/license-manifest.json")
  file(READ "${SDK_SOURCE}/license-manifest.json" _license_json)
  string(JSON _license_count LENGTH "${_license_json}")
  if(_license_count GREATER 0)
    math(EXPR _license_last "${_license_count} - 1")
    foreach(_index RANGE 0 ${_license_last})
      string(JSON _relative GET "${_license_json}" ${_index} path)
      string(REPLACE "\\" "/" _relative "${_relative}")
      if(IS_ABSOLUTE "${_relative}" OR _relative MATCHES "(^|/)[.][.](/|$)")
        message(FATAL_ERROR "Invalid native license path: ${_relative}")
      endif()
      if(NOT EXISTS "${SDK_SOURCE}/${_relative}" OR IS_DIRECTORY "${SDK_SOURCE}/${_relative}")
        message(FATAL_ERROR "Native license is missing: ${_relative}")
      endif()
      string(JSON _expected GET "${_license_json}" ${_index} sha256)
      string(TOLOWER "${_expected}" _expected)
      file(SHA256 "${SDK_SOURCE}/${_relative}" _actual)
      if(NOT _actual STREQUAL _expected)
        message(FATAL_ERROR "Native license checksum mismatch: ${_relative}")
      endif()
      if(NOT _relative STREQUAL "LICENSE")
        list(APPEND _license_files "${_relative}")
      endif()
    endforeach()
  endif()
endif()
foreach(_required native.dll ggml.dll ggml-base.dll)
  if(NOT EXISTS "${_raw}/${_required}")
    message(FATAL_ERROR "Source SDK build did not produce ${_required}")
  endif()
endforeach()
set(_cudnn false)
if(CUDNN_BIN)
  set(_cudnn_files)
  foreach(_required cudnn64_9.dll cudnn_graph64_9.dll cudnn_cnn64_9.dll cudnn_ops64_9.dll
      cudnn_adv64_9.dll cudnn_heuristic64_9.dll cudnn_ext64_9.dll cudnn_engines_tensor_ir64_9.dll
      cudnn_engines_precompiled64_9.dll cudnn_engines_runtime_compiled64_9.dll)
    if(NOT EXISTS "${CUDNN_BIN}/${_required}")
      message(FATAL_ERROR "cuDNN package is incomplete: ${_required}")
    endif()
    list(APPEND _cudnn_files "${CUDNN_BIN}/${_required}")
  endforeach()
  if(NOT EXISTS "${CUDNN_LICENSE}")
    message(FATAL_ERROR "cuDNN package license missing: ${CUDNN_LICENSE}")
  endif()
  list(APPEND _runtime ${_cudnn_files})
  set(_cudnn true)
endif()
file(MAKE_DIRECTORY "${_package}/bin" "${_package}/lib" "${_package}/include" "${_package}/model_specs" "${_package}/licenses")
set(_managed)
foreach(_file IN LISTS _runtime)
  get_filename_component(_name "${_file}" NAME)
  file(COPY_FILE "${_file}" "${_package}/bin/${_name}" ONLY_IF_DIFFERENT)
  list(APPEND _managed "${_name}")
endforeach()
file(GLOB _old RELATIVE "${_package}/bin" "${_package}/bin/*.dll")
foreach(_name IN LISTS _old)
  if(NOT _name IN_LIST _managed)
    file(REMOVE "${_package}/bin/${_name}")
    if(EXISTS "${_package}/bin/${_name}")
      message(FATAL_ERROR "Cannot remove obsolete source SDK runtime: ${_name}")
    endif()
  endif()
endforeach()
set(_managed_imports)
foreach(_pair AUDIOCPP GGML GGML_BASE)
  get_filename_component(_name "${${_pair}_IMPORT}" NAME)
  file(COPY_FILE "${${_pair}_IMPORT}" "${_package}/lib/${_name}" ONLY_IF_DIFFERENT)
  list(APPEND _managed_imports "${_name}")
endforeach()
file(GLOB _old_imports RELATIVE "${_package}/lib" "${_package}/lib/*.lib")
foreach(_name IN LISTS _old_imports)
  if(NOT _name IN_LIST _managed_imports)
    file(REMOVE "${_package}/lib/${_name}")
    if(EXISTS "${_package}/lib/${_name}")
      message(FATAL_ERROR "Cannot remove obsolete native import library: ${_name}")
    endif()
  endif()
endforeach()
file(COPY_FILE "${SDK_SOURCE}/include/audiocpp.h" "${_package}/include/audiocpp.h" ONLY_IF_DIFFERENT)
file(COPY_FILE "${SDK_SOURCE}/LICENSE" "${_package}/licenses/native-LICENSE" ONLY_IF_DIFFERENT)
file(REMOVE "${_package}/licenses/audio.cpp-LICENSE")
foreach(_relative IN LISTS _license_files)
  get_filename_component(_parent "${_relative}" DIRECTORY)
  file(MAKE_DIRECTORY "${_package}/licenses/third_party/${_parent}")
  file(COPY_FILE "${SDK_SOURCE}/${_relative}" "${_package}/licenses/third_party/${_relative}" ONLY_IF_DIFFERENT)
endforeach()
foreach(_name qwen3_asr.json qwen3_tts.json)
  file(COPY_FILE "${SDK_SOURCE}/model_specs/${_name}" "${_package}/model_specs/${_name}" ONLY_IF_DIFFERENT)
endforeach()
if(CUDNN_BIN)
  file(COPY_FILE "${CUDNN_LICENSE}" "${_package}/licenses/cuDNN-LICENSE" ONLY_IF_DIFFERENT)
elseif(EXISTS "${_package}/licenses/cuDNN-LICENSE")
  file(REMOVE "${_package}/licenses/cuDNN-LICENSE")
endif()
file(GLOB_RECURSE _files LIST_DIRECTORIES FALSE RELATIVE "${_package}"
  "${_package}/bin/*" "${_package}/lib/*" "${_package}/include/*" "${_package}/model_specs/*" "${_package}/licenses/*")
list(SORT _files)
set(_entries "[]")
set(_index 0)
foreach(_file IN LISTS _files)
  file(SHA256 "${_package}/${_file}" _hash)
  string(JSON _entry SET "{}" file "\"${_file}\"")
  string(JSON _entry SET "${_entry}" sha256 "\"${_hash}\"")
  string(JSON _entries SET "${_entries}" ${_index} "${_entry}")
  math(EXPR _index "${_index} + 1")
endforeach()
file(WRITE "${_package}/sdk-manifest.json"
  "{\"schema\":1,\"abi\":${_abi},\"build\":\"dev\",\"source\":\"project\",\"cudnn\":{\"enabled\":${_cudnn},\"version\":\"${CUDNN_VERSION}\"},\"files\":${_entries}}\n")
