cmake_minimum_required(VERSION 3.24)
foreach(_required PROBE_EXECUTABLE PROBE_MODE PROBE_TIMEOUT PROBE_OUTPUT_DIR)
  if(NOT DEFINED ${_required} OR "${${_required}}" STREQUAL "")
    message(FATAL_ERROR "Missing performance probe argument ${_required}")
  endif()
endforeach()
include("${CMAKE_CURRENT_LIST_DIR}/ProjectPaths.cmake")
get_filename_component(_owner_project "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
cmake_path(ABSOLUTE_PATH PROBE_OUTPUT_DIR)
hmi_require_build_path("${PROBE_OUTPUT_DIR}" "Performance diagnostic output" "${_owner_project}")
if(NOT PROBE_MODE MATCHES "^(inventory|perf_matrix)$")
  message(FATAL_ERROR "Invalid probe mode")
endif()
if(NOT PROBE_TIMEOUT MATCHES "^[1-9][0-9]*$")
  message(FATAL_ERROR "PROBE_TIMEOUT must be positive")
endif()
get_filename_component(_working "${PROBE_EXECUTABLE}" DIRECTORY)
file(MAKE_DIRECTORY "${PROBE_OUTPUT_DIR}")
execute_process(COMMAND "${CMAKE_COMMAND}" -E env --unset=GGML_BACKEND_PATH "${PROBE_EXECUTABLE}" inventory
  WORKING_DIRECTORY "${_working}" TIMEOUT "${PROBE_TIMEOUT}"
  OUTPUT_VARIABLE _inventory RESULT_VARIABLE _exit
  ERROR_FILE "${PROBE_OUTPUT_DIR}/inventory.stderr.log")
file(WRITE "${PROBE_OUTPUT_DIR}/inventory.json" "${_inventory}")
string(JSON _status ERROR_VARIABLE _json_error GET "${_inventory}" status)
if(NOT "${_exit}" STREQUAL "0" OR NOT _json_error STREQUAL "NOTFOUND" OR NOT _status STREQUAL "ok")
  message(FATAL_ERROR "ggml device inventory failed (${_exit}); see ${PROBE_OUTPUT_DIR}/inventory.stderr.log")
endif()
if(PROBE_MODE STREQUAL "inventory")
  message(STATUS "ggml hardware/backend inventory: ${PROBE_OUTPUT_DIR}/inventory.json")
  return()
endif()
foreach(_required PROBE_BACKENDS PROBE_THREADS PROBE_VARIANTS PROBE_OPS PROBE_SIZE PROBE_RUNS PROBE_OMP_WAIT)
  if(NOT DEFINED ${_required} OR "${${_required}}" STREQUAL "" OR "${${_required}}" MATCHES ";")
    message(FATAL_ERROR "Missing/invalid ${_required}; use comma-separated values")
  endif()
endforeach()
if(NOT PROBE_SIZE MATCHES "^[0-9]+$" OR PROBE_SIZE LESS 32 OR PROBE_SIZE GREATER 1024 OR
    NOT PROBE_RUNS MATCHES "^[0-9]+$" OR PROBE_RUNS LESS 1 OR PROBE_RUNS GREATER 100)
  message(FATAL_ERROR "Size must be 32..1024 and runs 1..100")
endif()
string(REPLACE "," ";" _threads "${PROBE_THREADS}")
string(REPLACE "," ";" _ops "${PROBE_OPS}")
string(REPLACE "," ";" _policies "${PROBE_OMP_WAIT}")
foreach(_thread IN LISTS _threads)
  if(NOT _thread MATCHES "^[1-9][0-9]*$" OR _thread GREATER 256)
    message(FATAL_ERROR "Each thread count must be 1..256")
  endif()
endforeach()
foreach(_op IN LISTS _ops)
  if(NOT _op MATCHES "^(matmul|softmax)$")
    message(FATAL_ERROR "Operation must be matmul or softmax")
  endif()
endforeach()
foreach(_policy IN LISTS _policies)
  if(NOT _policy MATCHES "^(ACTIVE|PASSIVE)$")
    message(FATAL_ERROR "OpenMP wait policy must be ACTIVE or PASSIVE")
  endif()
endforeach()
string(JSON _device_count LENGTH "${_inventory}" devices)
set(_available "")
set(_cpu_devices "")
set(_openmp_devices "")
if(_device_count GREATER 0)
  math(EXPR _last "${_device_count} - 1")
  foreach(_index RANGE 0 ${_last})
    string(JSON _name GET "${_inventory}" devices ${_index} name)
    string(JSON _cpu GET "${_inventory}" devices ${_index} cpu)
    string(JSON _openmp GET "${_inventory}" devices ${_index} openmp_enabled)
    list(APPEND _available "${_name}")
    if(_cpu)
      list(APPEND _cpu_devices "${_name}")
    endif()
    if(_openmp)
      list(APPEND _openmp_devices "${_name}")
    endif()
  endforeach()
endif()
if(PROBE_BACKENDS STREQUAL "auto")
  set(_backends "${_available}")
else()
  string(REPLACE "," ";" _backends "${PROBE_BACKENDS}")
endif()
if(NOT _backends)
  message(FATAL_ERROR "No ggml devices discovered")
endif()
foreach(_backend IN LISTS _backends)
  if(NOT _backend IN_LIST _available)
    message(FATAL_ERROR "Requested device ${_backend} is unavailable; inspect inventory.json")
  endif()
endforeach()
set(_variants "auto")
if(PROBE_VARIANTS STREQUAL "all")
  set(_variants "")
  string(JSON _count LENGTH "${_inventory}" cpu_variants)
  if(_count GREATER 0)
    math(EXPR _last "${_count} - 1")
    foreach(_index RANGE 0 ${_last})
      string(JSON _compatible GET "${_inventory}" cpu_variants ${_index} compatible)
      if(_compatible)
        string(JSON _file GET "${_inventory}" cpu_variants ${_index} file)
        list(APPEND _variants "${_file}")
      endif()
    endforeach()
  endif()
  if(NOT _variants)
    message(FATAL_ERROR "No compatible dynamic CPU variants discovered")
  endif()
elseif(NOT PROBE_VARIANTS STREQUAL "auto")
  string(REPLACE "," ";" _variants "${PROBE_VARIANTS}")
endif()
file(SHA256 "${_working}/ggml.dll" _core_hash)
file(SHA256 "${_working}/ggml-base.dll" _base_hash)
set(_measurements "[]")
set(_number 0)
set(_failed 0)
foreach(_backend IN LISTS _backends)
  if(_backend IN_LIST _cpu_devices)
    set(_device_threads "${_threads}")
    set(_device_variants "${_variants}")
    set(_device_policies "${_policies}")
    if(NOT _backend IN_LIST _openmp_devices)
      # An environment switch cannot enable OpenMP in a non-OpenMP DLL.
      set(_device_policies PASSIVE)
    endif()
  else()
    set(_device_threads 1)
    set(_device_variants auto)
    set(_device_policies PASSIVE)
  endif()
  foreach(_variant IN LISTS _device_variants)
    foreach(_thread IN LISTS _device_threads)
      foreach(_policy IN LISTS _device_policies)
        foreach(_op IN LISTS _ops)
          execute_process(COMMAND "${CMAKE_COMMAND}" -E env --unset=GGML_BACKEND_PATH
            "OMP_NUM_THREADS=${_thread}" "OMP_DYNAMIC=FALSE" "OMP_WAIT_POLICY=${_policy}"
            "${PROBE_EXECUTABLE}" perf --backend "${_backend}" --variant "${_variant}"
            --threads "${_thread}" --op "${_op}" --size "${PROBE_SIZE}" --runs "${PROBE_RUNS}"
            WORKING_DIRECTORY "${_working}" TIMEOUT "${PROBE_TIMEOUT}"
            OUTPUT_VARIABLE _result RESULT_VARIABLE _exit
            ERROR_FILE "${PROBE_OUTPUT_DIR}/measurement-${_number}.stderr.log")
          file(WRITE "${PROBE_OUTPUT_DIR}/measurement-${_number}.json" "${_result}")
          string(JSON _status ERROR_VARIABLE _json_error GET "${_result}" status)
          set(_valid FALSE)
          if(_json_error STREQUAL "NOTFOUND" AND _status STREQUAL "measured")
            string(JSON _median ERROR_VARIABLE _median_error GET "${_result}" median_us)
            string(JSON _minimum ERROR_VARIABLE _minimum_error GET "${_result}" minimum_us)
            string(JSON _runs ERROR_VARIABLE _runs_error GET "${_result}" runs)
            string(JSON _correct ERROR_VARIABLE _correct_error GET "${_result}" correct)
            string(JSON _reported_backend ERROR_VARIABLE _backend_error GET "${_result}" backend)
            if(_median_error STREQUAL "NOTFOUND" AND _minimum_error STREQUAL "NOTFOUND" AND
                _runs_error STREQUAL "NOTFOUND" AND _correct_error STREQUAL "NOTFOUND" AND
                _backend_error STREQUAL "NOTFOUND" AND _reported_backend STREQUAL _backend AND
                _median GREATER 0 AND _minimum GREATER 0 AND _runs EQUAL PROBE_RUNS AND _correct)
              set(_valid TRUE)
            endif()
          endif()
          if(NOT "${_exit}" STREQUAL "0" OR NOT _valid)
            math(EXPR _failed "${_failed} + 1")
          endif()
          if(_json_error STREQUAL "NOTFOUND")
            string(JSON _library ERROR_VARIABLE _library_error GET "${_result}" library)
            if(_library_error STREQUAL "NOTFOUND" AND EXISTS "${_working}/${_library}" AND NOT IS_DIRECTORY "${_working}/${_library}")
              file(SHA256 "${_working}/${_library}" _library_hash)
              string(JSON _result SET "${_result}" library_sha256 "\"${_library_hash}\"")
            endif()
            string(JSON _measurements SET "${_measurements}" ${_number} "${_result}")
          else()
            string(JSON _measurements SET "${_measurements}" ${_number} "{\"status\":\"failed\",\"error\":\"probe process failed or returned invalid JSON; inspect measurement log\"}")
          endif()
          math(EXPR _number "${_number} + 1")
        endforeach()
      endforeach()
    endforeach()
  endforeach()
endforeach()
file(WRITE "${PROBE_OUTPUT_DIR}/performance-matrix.json"
  "{\"schema\":1,\"ggml_sha256\":\"${_core_hash}\",\"ggml_base_sha256\":\"${_base_hash}\",\"failed\":${_failed},\"inventory\":${_inventory},\"measurements\":${_measurements}}\n")
if(_failed GREATER 0 OR _number EQUAL 0)
  message(FATAL_ERROR "ggml matrix failed: ${_failed} failed of ${_number}; inspect performance-matrix.json")
endif()
message(STATUS "ggml matrix: ${_number} independently validated measurements; ${PROBE_OUTPUT_DIR}/performance-matrix.json")
