include_guard(GLOBAL)

# Resolve existing ancestors before checking paths that may not exist yet.
function(_hmi_resolve_project_path path description project_result path_result)
  # The explicit root also supports checks before project() and nested fixtures.
  set(_root "${PROJECT_SOURCE_DIR}")
  if(ARGC GREATER 4)
    set(_root "${ARGV4}")
  elseif(_root STREQUAL "")
    set(_root "${CMAKE_SOURCE_DIR}")
  endif()
  if(NOT IS_DIRECTORY "${_root}")
    message(FATAL_ERROR "Project root is not a directory: ${_root}")
  endif()
  file(REAL_PATH "${_root}" _project)
  set(_selected "${path}")
  cmake_path(ABSOLUTE_PATH _selected BASE_DIRECTORY "${_project}")
  set(_ancestor "${_selected}")
  set(_tail "")
  while(NOT EXISTS "${_ancestor}")
    if(IS_SYMLINK "${_ancestor}")
      message(FATAL_ERROR "${description} traverses a broken symbolic link: ${path}")
    endif()
    cmake_path(GET _ancestor FILENAME _name)
    cmake_path(GET _ancestor PARENT_PATH _parent)
    if(_parent STREQUAL _ancestor OR _name STREQUAL "")
      message(FATAL_ERROR "Cannot resolve ${description}: ${path}")
    endif()
    set(_tail "/${_name}${_tail}")
    set(_ancestor "${_parent}")
  endwhile()
  cmake_policy(PUSH)
  if(POLICY CMP0152)
    cmake_policy(SET CMP0152 NEW)
  endif()
  file(REAL_PATH "${_ancestor}" _ancestor)
  cmake_policy(POP)
  set(_selected "${_ancestor}${_tail}")
  if(WIN32)
    string(TOLOWER "${_project}" _project)
    string(TOLOWER "${_selected}" _selected)
  endif()
  cmake_path(IS_PREFIX _project "${_selected}" NORMALIZE _inside)
  if(NOT _inside)
    message(FATAL_ERROR "${description} must stay inside the project: ${path}")
  endif()
  set(${project_result} "${_project}" PARENT_SCOPE)
  set(${path_result} "${_selected}" PARENT_SCOPE)
endfunction()

# Source and model inputs can live anywhere inside the owning project.
function(hmi_require_project_path path description)
  if(ARGC GREATER 2)
    _hmi_resolve_project_path("${path}" "${description}" _project _selected "${ARGV2}")
  else()
    _hmi_resolve_project_path("${path}" "${description}" _project _selected)
  endif()
endfunction()

# Generated files belong to the physical build tree, including nested builds.
function(hmi_require_build_path path description)
  if(ARGC GREATER 2)
    _hmi_resolve_project_path("${path}" "${description}" _project _selected "${ARGV2}")
  else()
    _hmi_resolve_project_path("${path}" "${description}" _project _selected)
  endif()
  # Do not resolve this boundary through a build/ junction into the source tree.
  set(_build "${_project}/build")
  cmake_path(IS_PREFIX _build "${_selected}" NORMALIZE _inside_build)
  if(NOT _inside_build)
    message(FATAL_ERROR "${description} must stay inside the project build directory: ${path}")
  endif()
endfunction()

# Check overrides before target creation inherits them, including overrides
# from a previous cache or a configuration not selected for this build.
function(hmi_require_build_outputs binary_directory project_root)
  hmi_require_build_path("${binary_directory}" "Build output" "${project_root}")
  set(_configurations ${CMAKE_CONFIGURATION_TYPES} ${CMAKE_BUILD_TYPE}
    Debug Release RelWithDebInfo MinSizeRel)
  list(REMOVE_DUPLICATES _configurations)
  get_cmake_property(_variables VARIABLES)
  foreach(_variable IN LISTS _variables)
    if(_variable MATCHES "^CMAKE_(RUNTIME|LIBRARY|ARCHIVE|PDB|COMPILE_PDB)_OUTPUT_DIRECTORY(_.+)?$"
        AND NOT "${${_variable}}" STREQUAL "")
      foreach(_configuration IN LISTS _configurations)
        string(REPLACE "$<CONFIG>" "${_configuration}" _output "${${_variable}}")
        if(_output MATCHES "\\$<")
          message(FATAL_ERROR "${_variable} has an unsupported generator expression; use a build-local directory, optionally with $<CONFIG>.")
        endif()
        # Preserve symlink/.. ordering for the canonical resolver below.
        cmake_path(ABSOLUTE_PATH _output BASE_DIRECTORY "${binary_directory}")
        hmi_require_build_path("${_output}" "${_variable}" "${project_root}")
      endforeach()
    endif()
  endforeach()
endfunction()
