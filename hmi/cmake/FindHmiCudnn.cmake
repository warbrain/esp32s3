include_guard(GLOBAL)

# Resolve one complete cuDNN set without find_path/find_library cache or PATH
# fallback. An installed CUDA-specific tree must match major.minor exactly.
# Flat archives must identify their CUDA family in the directory name or an
# explicit association; their version.h identifies cuDNN, not CUDA.
function(hmi_find_cudnn prefix)
  cmake_policy(PUSH)
  if(POLICY CMP0174)
    cmake_policy(SET CMP0174 NEW)
  endif()
  cmake_parse_arguments(PARSE_ARGV 1 _arg "" "ROOT;CUDA_VERSION;ARCHIVE_CUDA_VERSION" "")
  cmake_policy(POP)
  foreach(_field FOUND ROOT INCLUDE_DIR LIBRARY RUNTIME_BIN VERSION CUDA_VERSION RUNTIME_FILES ERROR)
    set(${prefix}_${_field} "" PARENT_SCOPE)
  endforeach()
  set(${prefix}_FOUND FALSE PARENT_SCOPE)
  if(NOT _arg_CUDA_VERSION MATCHES "^([0-9]+)\.([0-9]+)(\.[0-9]+)?$")
    set(${prefix}_ERROR "CUDA_VERSION must identify the selected toolkit as major.minor" PARENT_SCOPE)
    return()
  endif()
  set(_cuda_major "${CMAKE_MATCH_1}")
  set(_cuda_line "${CMAKE_MATCH_1}.${CMAKE_MATCH_2}")
  set(_roots "")
  if(_arg_ROOT)
    list(APPEND _roots "${_arg_ROOT}")
  else()
    if(DEFINED ENV{CUDNN_ROOT} AND NOT "$ENV{CUDNN_ROOT}" STREQUAL "")
      list(APPEND _roots "$ENV{CUDNN_ROOT}")
    endif()
    if(DEFINED ENV{ProgramFiles})
      file(GLOB _installed LIST_DIRECTORIES TRUE "$ENV{ProgramFiles}/NVIDIA/CUDNN/v*")
      list(SORT _installed COMPARE NATURAL ORDER DESCENDING)
      list(APPEND _roots ${_installed})
    endif()
  endif()
  set(_error "cuDNN for CUDA ${_cuda_line} was not found; set HMI_CUDNN_ROOT to its installation/archive root")
  foreach(_root IN LISTS _roots)
    file(REAL_PATH "${_root}" _root)
    file(GLOB _versioned_headers "${_root}/include/*/cudnn.h")
    if(_versioned_headers)
      set(_include "${_root}/include/${_cuda_line}")
      set(_library "${_root}/lib/${_cuda_line}/x64/cudnn.lib")
      set(_bin "${_root}/bin/${_cuda_line}/x64")
      if(NOT EXISTS "${_include}/cudnn.h" OR NOT EXISTS "${_library}" OR NOT IS_DIRECTORY "${_bin}")
        set(_error "cuDNN root ${_root} has no complete CUDA ${_cuda_line} include/lib/bin set; a different CUDA version will not be substituted")
        continue()
      endif()
    else()
      set(_archive_cuda "${_arg_ARCHIVE_CUDA_VERSION}")
      if(NOT _archive_cuda)
        get_filename_component(_archive_name "${_root}" NAME)
        if(_archive_name MATCHES "[Cc][Uu][Dd][Aa]([0-9]+)(\.[0-9]+)?([_-]|$)")
          set(_archive_cuda "${CMAKE_MATCH_1}${CMAKE_MATCH_2}")
        endif()
      endif()
      if(NOT _archive_cuda MATCHES "^([0-9]+)(\.([0-9]+))?$")
        set(_error "Flat cuDNN archive ${_root} has no CUDA association; use a cuda13 archive name or set HMI_CUDNN_ARCHIVE_CUDA_VERSION explicitly")
        continue()
      endif()
      set(_archive_major "${CMAKE_MATCH_1}")
      set(_archive_minor "${CMAKE_MATCH_3}")
      if(NOT _archive_major STREQUAL _cuda_major OR (NOT _archive_minor STREQUAL "" AND NOT "${_archive_major}.${_archive_minor}" STREQUAL _cuda_line))
        set(_error "Flat cuDNN archive targets CUDA ${_archive_cuda}, selected toolkit is ${_cuda_line}")
        continue()
      endif()
      set(_include "${_root}/include")
      set(_library "")
      foreach(_libdir lib/x64 lib lib64)
        if(EXISTS "${_root}/${_libdir}/cudnn.lib")
          set(_library "${_root}/${_libdir}/cudnn.lib")
          break()
        endif()
      endforeach()
      set(_bin "")
      foreach(_bindir bin/x64 bin)
        if(EXISTS "${_root}/${_bindir}/cudnn64_9.dll")
          set(_bin "${_root}/${_bindir}")
          break()
        endif()
      endforeach()
      if(NOT EXISTS "${_include}/cudnn.h" OR NOT _library OR NOT _bin)
        set(_error "Flat cuDNN archive ${_root} is missing its matching include/lib/bin files")
        continue()
      endif()
    endif()
    if(NOT EXISTS "${_include}/cudnn_version.h")
      set(_error "cuDNN version header missing from ${_include}")
      continue()
    endif()
    file(READ "${_include}/cudnn_version.h" _version_text)
    foreach(_part MAJOR MINOR PATCHLEVEL)
      if(NOT _version_text MATCHES "#[ \t]*define[ \t]+CUDNN_${_part}[ \t]+([0-9]+)")
        set(_version_${_part} "")
      else()
        set(_version_${_part} "${CMAKE_MATCH_1}")
      endif()
    endforeach()
    if(NOT _version_MAJOR STREQUAL "9" OR _version_MINOR STREQUAL "" OR _version_PATCHLEVEL STREQUAL "")
      set(_error "This cuDNN integration requires a valid cuDNN 9 version header")
      continue()
    endif()
    set(_missing "")
    foreach(_component "" _adv _cnn _graph _heuristic _ops _engines_precompiled _engines_runtime_compiled)
      if(NOT EXISTS "${_bin}/cudnn${_component}64_9.dll")
        list(APPEND _missing "cudnn${_component}64_9.dll")
      endif()
    endforeach()
    if(_missing)
      set(_error "cuDNN runtime set in ${_bin} is incomplete: ${_missing}")
      continue()
    endif()
    file(GLOB _runtime_files "${_bin}/cudnn*64_9.dll")
    list(SORT _runtime_files)
    set(${prefix}_FOUND TRUE PARENT_SCOPE)
    set(${prefix}_ROOT "${_root}" PARENT_SCOPE)
    set(${prefix}_INCLUDE_DIR "${_include}" PARENT_SCOPE)
    set(${prefix}_LIBRARY "${_library}" PARENT_SCOPE)
    set(${prefix}_RUNTIME_BIN "${_bin}" PARENT_SCOPE)
    set(${prefix}_RUNTIME_FILES "${_runtime_files}" PARENT_SCOPE)
    set(${prefix}_VERSION "${_version_MAJOR}.${_version_MINOR}.${_version_PATCHLEVEL}" PARENT_SCOPE)
    set(${prefix}_CUDA_VERSION "${_cuda_line}" PARENT_SCOPE)
    set(${prefix}_ERROR "" PARENT_SCOPE)
    return()
  endforeach()
  set(${prefix}_ERROR "${_error}" PARENT_SCOPE)
endfunction()
