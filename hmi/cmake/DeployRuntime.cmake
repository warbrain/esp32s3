cmake_minimum_required(VERSION 3.24)

foreach(_argument IN ITEMS SOURCE_DIR DESTINATION_DIR)
  if(NOT DEFINED ${_argument} OR "${${_argument}}" STREQUAL "")
    message(FATAL_ERROR "Missing runtime deployment argument: ${_argument}")
  endif()
endforeach()
include("${CMAKE_CURRENT_LIST_DIR}/ProjectPaths.cmake")
get_filename_component(_owner_project "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
cmake_path(ABSOLUTE_PATH SOURCE_DIR NORMALIZE OUTPUT_VARIABLE _source)
cmake_path(ABSOLUTE_PATH DESTINATION_DIR OUTPUT_VARIABLE _destination)
hmi_require_build_path("${_destination}" "Runtime DLL output" "${_owner_project}")
if(NOT IS_DIRECTORY "${_source}")
  message(FATAL_ERROR "SDK runtime source does not exist: ${_source}")
endif()
file(REAL_PATH "${_source}" _source)
set(_ancestor "${_destination}")
set(_missing "")
while(NOT EXISTS "${_ancestor}")
  get_filename_component(_name "${_ancestor}" NAME)
  get_filename_component(_parent "${_ancestor}" DIRECTORY)
  if(_parent STREQUAL _ancestor OR _name STREQUAL "")
    message(FATAL_ERROR "Cannot resolve runtime destination parent: ${_destination}")
  endif()
  set(_missing "/${_name}${_missing}")
  set(_ancestor "${_parent}")
endwhile()
file(REAL_PATH "${_ancestor}" _ancestor)
set(_destination "${_ancestor}${_missing}")
set(_source_compare "${_source}")
set(_destination_compare "${_destination}")
if(WIN32)
  string(TOLOWER "${_source_compare}" _source_compare)
  string(TOLOWER "${_destination_compare}" _destination_compare)
endif()
cmake_path(IS_PREFIX _source_compare "${_destination_compare}" NORMALIZE _inside_source)
cmake_path(IS_PREFIX _destination_compare "${_source_compare}" NORMALIZE _contains_source)
if(_inside_source OR _contains_source)
  message(FATAL_ERROR "SDK source and runtime destination must be separate directories.")
endif()

# The manifest is generated only after a complete SDK build passes its loader
# check. Validate the header/imports/specifications too, before deploying DLLs.
get_filename_component(_sdk_root "${_source}" DIRECTORY)
set(_manifest "${_sdk_root}/sdk-manifest.json")
if(EXISTS "${_manifest}")
  file(READ "${_manifest}" _json)
  string(JSON _count LENGTH "${_json}" files)
  if(_count LESS 1)
    message(FATAL_ERROR "SDK manifest has no files: ${_manifest}")
  endif()
  math(EXPR _last "${_count} - 1")
  set(_expected_dlls)
  foreach(_index RANGE 0 ${_last})
    string(JSON _relative GET "${_json}" files ${_index} file)
    string(JSON _expected GET "${_json}" files ${_index} sha256)
    if(IS_ABSOLUTE "${_relative}" OR _relative MATCHES "(^|[/\\\\])[.][.]([/\\\\]|$)")
      message(FATAL_ERROR "Invalid SDK manifest path: ${_relative}")
    endif()
    if(NOT EXISTS "${_sdk_root}/${_relative}")
      message(FATAL_ERROR "SDK manifest file missing: ${_relative}. Rebuild the project's hmi_audio_sdk target.")
    endif()
    file(SHA256 "${_sdk_root}/${_relative}" _actual)
    string(TOLOWER "${_expected}" _expected)
    if(NOT _actual STREQUAL _expected)
      message(FATAL_ERROR "SDK checksum mismatch: ${_relative}. Rebuild the project's hmi_audio_sdk target as a complete set.")
    endif()
    if(_relative MATCHES "^bin[/\\\\]([^/\\\\]+[.]dll)$")
      list(APPEND _expected_dlls "${CMAKE_MATCH_1}")
    endif()
  endforeach()
  file(GLOB _actual_dlls RELATIVE "${_source}" "${_source}/*.dll")
  list(SORT _expected_dlls)
  list(SORT _actual_dlls)
  if(NOT "${_expected_dlls}" STREQUAL "${_actual_dlls}")
    message(FATAL_ERROR "SDK DLL set differs from its manifest. Synchronize the complete SDK before building.")
  endif()
elseif(REQUIRE_MANIFEST)
  message(FATAL_ERROR "SDK manifest missing: ${_manifest}. Build the project's hmi_audio_sdk target first.")
endif()

file(GLOB _files RELATIVE "${_source}" "${_source}/*.dll")
if(NOT _files)
  message(FATAL_ERROR "No SDK DLLs to deploy: ${_source}")
endif()
file(MAKE_DIRECTORY "${_destination}")
# Only the dedicated SDK plugin directory is managed. Never recurse or delete
# application files, user configuration, models or another SDK revision.
file(GLOB _previous RELATIVE "${_destination}" "${_destination}/*.dll")
foreach(_file IN LISTS _files)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E copy_if_different
    "${_source}/${_file}" "${_destination}/${_file}"
    COMMAND_ERROR_IS_FATAL ANY)
endforeach()
foreach(_file IN LISTS _previous)
  if(NOT _file IN_LIST _files)
    file(REMOVE "${_destination}/${_file}")
    if(EXISTS "${_destination}/${_file}")
      message(FATAL_ERROR "Cannot remove obsolete SDK plugin: ${_destination}/${_file}")
    endif()
  endif()
endforeach()
